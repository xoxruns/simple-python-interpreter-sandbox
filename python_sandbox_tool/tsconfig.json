{
    "compilerOptions": {
        "module": "ESNext",
        "moduleResolution": "Node",
        "target": "ES2022",
        "jsx": "react",
        "strictNullChecks": true,
        "strictFunctionTypes": true,
        "sourceMap": true,
        "skipLibCheck": true,
        "noEmit": true
    },
    "include": ["./**/*.ts"],
    "exclude": ["node_modules", "**/node_modules/*"]
}
